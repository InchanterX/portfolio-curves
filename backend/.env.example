# REST API GCURVE (IRRBB). Скопируйте в .env и поправьте под свою установку Postgres.

# Строка подключения Postgres 16 (база должна содержать существующую схему
# auth/ref/market/app/calc/audit + применённую миграцию irrbb_migration.sql)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/irrbb

# Порт HTTP-сервера. Фронтенд (vite) проксирует /api -> http://localhost:4000
PORT=4000

# CORS: в dev фронтенд и так идёт через vite-прокси, этот origin нужен только
# при обращении к API напрямую (например из Postman на другом порту)
CORS_ORIGIN=http://localhost:5173

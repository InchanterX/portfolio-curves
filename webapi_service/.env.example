# Supply a DSN to an existing database with the agreed DBML schema. No auto-migrations.
DATABASE_DSN=postgresql://curves:REPLACE_ME@localhost:5432/curves_db
SESSION_HOURS=24
ACTION_TOKEN_MINUTES=30
AUTH_REQUESTS_PER_MINUTE=10
# SMTP requires STARTTLS; leave unset to explicitly disable delivery-dependent operations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
STORAGE_ADAPTER=disabled
